{
  "name": "anamorphic",
  "version": "0.1.0",
  "description": "Head-tracked off-axis projection for a web page. The camera finds your eyes and the page is re-projected from that exact viewpoint.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sendar0.github.io/anamorphic.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sendar0/anamorphic.js.git"
  },
  "bugs": "https://github.com/sendar0/anamorphic.js/issues",
  "keywords": [
    "head-tracking",
    "anamorphosis",
    "parallax",
    "perspective",
    "webcam",
    "mediapipe",
    "svelte"
  ],
  "sideEffects": ["*.css"],
  "files": ["lib", "svelte", "anamorphic.css", "README.md", "LICENSE"],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./room": {
      "types": "./lib/room.d.ts",
      "default": "./lib/room.js"
    },
    "./svelte": {
      "svelte": "./svelte/index.js",
      "default": "./svelte/index.js"
    },
    "./anamorphic.css": "./anamorphic.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": { "optional": true }
  },
  "devDependencies": {
    "svelte": "^5.20.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "clean": "rm -rf lib dist",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run check"
  }
}
